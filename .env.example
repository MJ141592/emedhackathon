# Server-side only. Create at https://runware.ai/console
RUNWARE_API_KEY=

# Optional Runware AIR model overrides
RUNWARE_CHAT_MODEL=google:gemini@3.1-flash-lite
RUNWARE_VISION_MODEL=google:gemini@3.1-flash-lite
RUNWARE_TRANSCRIPTION_MODEL=google:gemini@3.1-flash-lite
RUNWARE_SPEECH_MODEL=xai:tts@0

# Optional SQLite path. Defaults to backend/data/emed-demo.sqlite3
# EMED_DB_PATH=/absolute/path/to/emed-demo.sqlite3

# Required in deployed environments: a URL-safe 32-byte Fernet key.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Local development creates a mode-0600 <database>.key sidecar when this is unset.
EMED_DATA_ENCRYPTION_KEY=
